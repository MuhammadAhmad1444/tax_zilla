Options -MultiViews -Indexes

# Point the default index to the built app
DirectoryIndex dist/index.html

RewriteEngine On

# ── Already inside /dist/ → pass through unchanged ───────────
RewriteCond %{REQUEST_URI} ^/dist/ [NC]
RewriteRule ^ - [L]

# ── Real file exists inside dist/ → serve it ─────────────────
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ /dist/$1 [L]

# ── Real directory exists inside dist/ → serve it ────────────
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -d
RewriteRule ^(.*)$ /dist/$1 [L]

# ── Everything else → React SPA fallback ─────────────────────
RewriteRule ^ /dist/index.html [L]
