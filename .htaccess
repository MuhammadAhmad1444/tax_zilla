Options -MultiViews
DirectoryIndex dist/index.html

RewriteEngine On
RewriteBase /

# Already inside /dist/ — serve directly, no loop
RewriteCond %{REQUEST_URI} ^/dist/
RewriteRule ^ - [L]

# Root request → built app
RewriteRule ^$ /dist/index.html [L,QSA]

# Asset/image files that exist inside dist/ → serve them from dist/
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.+)$ /dist/$1 [L,QSA]

# All React routes (SPA fallback) → built app
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /dist/index.html [L,QSA]
