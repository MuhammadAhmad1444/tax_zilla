Options -MultiViews
DirectoryIndex dist/index.html

RewriteEngine On
RewriteBase /

# Already in /dist/ — serve directly
RewriteCond %{REQUEST_URI} ^/dist/
RewriteRule ^ - [L]

# Root or index.html → always serve built app
RewriteRule ^(index\.html)?$ /dist/index.html [L,QSA]

# Real asset files inside dist/ → serve them
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.+)$ /dist/$1 [L,QSA]

# SPA fallback — all React routes → built app
RewriteRule ^ /dist/index.html [L,QSA]
