Options -MultiViews
RewriteEngine On

# ── 1. Let /dist/ requests pass through as-is ────────────────
RewriteCond %{REQUEST_URI} ^/dist/
RewriteRule ^ - [L]

# ── 2. Root URL → built index ────────────────────────────────
RewriteRule ^$ /dist/index.html [L]

# ── 3. Real asset files (JS, CSS, images, fonts) in dist/ ────
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.+)$ /dist/$1 [L]

# ── 4. SPA fallback — all routes → React app ─────────────────
RewriteRule ^ /dist/index.html [L]
